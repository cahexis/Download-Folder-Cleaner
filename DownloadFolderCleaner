import tkinter as tk
import os
from pathlib import Path
import shutil

#Paths of the Downloads folder and the user's Desktop (assuming that it isnt the onedrive folder to desktop)
Downloads = Path.home() / "Downloads"
Desktop = Path.home() / "Desktop"

#Looks and grabs these files below for organization
#Documents = ["pdf","docx", "xlsx"]
#Media = []"png","jpg"]

#Defines the folders being created
fold0 = Path.home() / "Desktop" / "Organized Files Inside"
fold1 = fold0 / "Documents"
fold2 = fold0 / "Media"

#Whole setup and setting the label's to one for the "finished" screen
def on_active():
    os.chdir(Desktop)
    os.mkdir(fold0)
    os.mkdir(fold1)
    os.mkdir(fold2)
    os.chdir(Downloads)
    for file in os.listdir(Downloads):
        if file.endswith(".pdf") or file.endswith(".docx") or file.endswith(".xlsx"):
            shutil.move(str(file), str(fold1))
        if file.endswith(".png") or file.endswith(".jpg"):
            shutil.move(str(file), str(fold2))

    lbl2.destroy()
    lbl1.destroy()
    btn1.destroy()
    btn2.destroy()
    lblf = tk.Label(root, text="Finished :) You may now close the program.")
    lblf.grid(row=1,column=0)


def exit():
    root.destroy()


#Below is the labels and buttons used for all the text
root = tk.Tk()
root.geometry("330x170")
root.title("Download Folder Cleaner")
root.resizable(width=False, height=False)

lbl1 = tk.Label(root, text="Are you sure you want to clean up?")
lbl1.grid(row=0,column=0)
lbl2 = tk.Label(root, text="WARNING, THIS WILL MAKE FOLDERS ON YOUR DESKTOP.")
lbl2.grid(row=1,column=0)

btn1 = tk.Button(root, text="Yes", command=on_active, width=10, height=2)
btn1.place(x=5,y=85)
btn2 = tk.Button(root, text="No", command=exit, width=10, height=2)
btn2.place(x=245, y=85)

root.mainloop()